# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_string

# --- MySQL ---
# Point these at your MySQL/MariaDB server. Locally that's usually 127.0.0.1:3306
# with the root user (or a dedicated user you create). In production, use your
# hosted MySQL provider's connection details (see DEPLOYMENT.md).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fotonix
